{
  "name": "media-naming-compressor",
  "version": "0.8.0",
  "private": true,
  "description": "Free browser-local batch media naming and WebCodecs compression workbench with FFmpeg fallback.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-ffmpeg-core.js",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/sync-ffmpeg-core.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node --check src/app.js && node --check scripts/sync-ffmpeg-core.js && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "jszip": "^3.10.2",
    "mediabunny": "^1.58.0"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "vite": "^8.3.0"
  }
}
